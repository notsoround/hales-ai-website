# Vapi.ai API Configuration
VITE_VAPI_API_KEY=your-vapi-api-key
VITE_VAPI_ASSISTANT_ID=your-vapi-assistant-id

# Cupcake Dashboard Password
VITE_CUPCAKE_PASSWORD=your-dashboard-password

# CupcakeGPT PWA — scoped to /cupcake-feed, /cupcake-chat, /cupcake-food-photo.
# Do NOT use the Cupcake Build Key here; that key unlocks deploy and other systems.
VITE_CUPCAKEGPT_KEY=

# GitHub Credentials (required for deployment)
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=your-github-personal-access-token
